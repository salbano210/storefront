# =============================================================================
# Storefront Multi-Agent Creator Relationship Demo -- environment configuration
# =============================================================================
# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored -- never commit real secrets.
#
#   cp .env.example backend/.env
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: OpenRouter API key
# -----------------------------------------------------------------------------
# Get yours at: https://openrouter.ai/keys
# The demo is host-key only: every agent call uses this key. Create a dedicated
# key for the demo and set a credit limit on it so a shared link can never spend
# more than you intended.
OPENROUTER_API_KEY=

# Optional: identifies this app in your OpenRouter dashboard
OPENROUTER_APP_NAME=storefront
OPENROUTER_APP_URL=https://github.com/salbano210/storefront

# -----------------------------------------------------------------------------
# Default models (seeded into the brand config on first boot).
# Override per-agent from the admin UI at /admin -- no code change required.
# -----------------------------------------------------------------------------
OPENROUTER_MODEL_ROUTER=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_GIFT_REQUEST=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_FALLBACK=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Admin / demo protection
# -----------------------------------------------------------------------------
# Passcode for /admin and the "all sessions" log view. Leave blank for an
# open, unprotected local dev instance.
ADMIN_PASSCODE=

# Signs session cookies. Render generates this automatically via render.yaml.
SESSION_SECRET=dev-secret-change-me

# -----------------------------------------------------------------------------
# Budget + abuse guards
# -----------------------------------------------------------------------------
MAX_DAILY_SPEND_USD=2.0
SESSION_MESSAGE_CAP=40
IP_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Sample history (optional)
# -----------------------------------------------------------------------------
# Generate a backdated sample history at boot when the database has none, so the
# logs and the dashboard are not empty on a fresh instance. It uses the offline
# model, so it costs nothing and needs no API key, and takes a few seconds.
# The conversations it makes are labelled as sample data in the UI.
SEED_DEMO_HISTORY=
SEED_DEMO_DAYS=90
SEED_DEMO_COUNT=120

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# SQLite file location. On Render's free tier this is ephemeral -- the demo
# reseeds its default brand config on every boot.
DATA_DIR=./data

# Set DATABASE_URL to a Postgres/Neon instance to make logs + config durable.
# DATABASE_URL=postgresql://user:pass@host/db
